# AISstream.io — https://aisstream.io  (free, WebSocket only)
AISSTREAM_API_KEY=

# Optional. When set, the server appends every raw AIS envelope received
# (newline-delimited JSON) to this path for later use as normalize test
# fixtures. Leave blank to disable — off by default.
AIS_CAPTURE_PATH=

# Optional. Port the display-client broadcast WebSocketServer listens on.
# Defaults to 8080 if unset.
WAKE_BROADCAST_PORT=

# Optional. Same port, exposed to the display's browser bundle -- Vite
# only exposes VITE_-prefixed vars to client code, so this is a separate
# entry from WAKE_BROADCAST_PORT above, not a duplicate. Keep the two in
# sync by hand. Defaults to 8080 if unset.
VITE_WAKE_BROADCAST_PORT=

# Required for `.\pnpm.exe --filter @wake/server replay` (replay mode --
# drives the display from a captured NDJSON file with zero AISstream
# connections; see CLAUDE.md). No default -- replay refuses to start
# without it rather than silently starting empty.
#
# Path trap: pnpm --filter sets cwd to server/, not the repo root, so a
# relative path here resolves from server/ -- exactly like
# AIS_CAPTURE_PATH above. The existing capture lives at
# server/server/captures/dover-30min.ndjson from the repo root, which
# means the correct value here, run from server/, is:
#   server/captures/dover-30min.ndjson
WAKE_REPLAY_PATH=

# Optional. Multiplies replay pace -- 2 plays twice as fast, 0.5 half as
# fast. Fixed at startup; not adjustable mid-session. Defaults to 1
# (real captured pace) if unset.
WAKE_REPLAY_SPEED=

# Optional. Minutes `pnpm --filter @wake/server capacity-capture` (RISK-1)
# runs before stopping itself gracefully. Defaults to 60 if unset. Human
# runs this tool directly -- it opens two real AISstream connections.
CAPACITY_CAPTURE_DURATION_MIN=

# DEMO-1. Demo area: dover | istanbul | portsaid | sydney. Blank/unset
# means dover. An invalid value refuses the live server and falls back
# to dover (with a console warning) on the display.
WAKE_AREA=

# DEMO-1. AIS data source: aisstream | aiscast. Blank/unset means
# aisstream.
WAKE_AIS_SOURCE=

# DEMO-1. Required only when WAKE_AIS_SOURCE=aiscast -- aiscast's token
# goes in the same APIKey field of the subscribe message. Personal
# tokens are self-serve (openwatersio.github.io/aiscast/token.html).
AISCAST_TOKEN=

# LANDING-5. Resend, for the landing page's signup form. These are read by
# the SERVERLESS FUNCTION (landing/functions/api/subscribe.ts), not by any
# process in this repo -- set them in the hosting platform's environment,
# not here. They are listed in this file only so the names are on the
# record; nothing local reads them.
#
# The key is sent as "Authorization: Bearer <key>" and appears nowhere
# else -- not in a URL, a body, or a log line.
RESEND_API_KEY=

# The list the address is added to. Resend's audiences are deprecated in
# favour of segments ("These endpoints still work, but will be removed in
# the future"), so the default request is POST /contacts with
# segments: [{ id }], and this should hold a SEGMENT id. The variable keeps
# its original name so an existing deployment's variable does not have to
# be renamed.
RESEND_AUDIENCE_ID=

# Optional. Any non-empty value switches to the deprecated
# POST /audiences/{id}/contacts endpoint, for an account that still has an
# audience rather than a segment. Blank/unset uses the current API.
RESEND_USE_LEGACY_AUDIENCE=
