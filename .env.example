# Copy this file to .env (same folder) and fill in the key after AISSTREAM_API_KEY=
# Name first, then =, then the key: no quotes, no spaces.
# AISstream.io — https://aisstream.io  (free, WebSocket only)
AISSTREAM_API_KEY=

# Optional settings: remove the leading # from a line to use it.
# Optional. When set, the server appends every raw AIS envelope received
# (newline-delimited JSON) to this path for later use as normalize test
# fixtures. Leave blank to disable — off by default.
# AIS_CAPTURE_PATH=

# Optional. Port the display-client broadcast WebSocketServer listens on.
# Defaults to 8080 if unset.
# WAKE_BROADCAST_PORT=

# Optional. Same port, exposed to the display's browser bundle -- Vite
# only exposes VITE_-prefixed vars to client code, so this is a separate
# entry from WAKE_BROADCAST_PORT above, not a duplicate. Keep the two in
# sync by hand. Defaults to 8080 if unset.
# VITE_WAKE_BROADCAST_PORT=

# Optional. `pnpm --filter @wake/server replay` drives the display from a
# captured NDJSON file without opening an AISstream connection. A fresh
# clone contains no capture file. To record one, set AIS_CAPTURE_PATH while
# the server runs; then set WAKE_REPLAY_PATH to that file and start replay.
#
# pnpm --filter sets cwd to server/, not the repo root, so relative paths
# resolve from server/ for both AIS_CAPTURE_PATH and WAKE_REPLAY_PATH.
# Example WAKE_REPLAY_PATH: captures/my-run.ndjson
# WAKE_REPLAY_PATH=

# Optional. Multiplies replay pace -- 2 plays twice as fast, 0.5 half as
# fast. Fixed at startup; not adjustable mid-session. Defaults to 1
# (real captured pace) if unset.
# WAKE_REPLAY_SPEED=

# Optional. Minutes `pnpm --filter @wake/server capacity-capture` runs
# before stopping itself gracefully. Defaults to 60 if unset. This is a
# developer tool that opens two simultaneous AISstream connections with
# your key; it is not needed for normal use.
# CAPACITY_CAPTURE_DURATION_MIN=

# Area: dover | istanbul | portsaid | sydney. Blank/unset means dover.
# An invalid value refuses the live server and falls back to dover (with
# a console warning) on the display.
# WAKE_AREA=

# AIS data source: aisstream | aiscast. Blank/unset means aisstream.
# aiscast is experimental: in testing the display showed far fewer
# vessels than the server tracked; aisstream is the supported source.
# WAKE_AIS_SOURCE=

# Required only when WAKE_AIS_SOURCE=aiscast -- aiscast's token goes in
# the same APIKey field of the subscribe message. Personal tokens are
# self-serve (openwatersio.github.io/aiscast/token.html).
# AISCAST_TOKEN=

